  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6F695F", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string.begin", "punctuation.definition.string.end"],
      "settings": { "foreground": "#94C47E" }
    },
    {
      "name": "Number and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"],
      "settings": { "foreground": "#D2B26F" }
    },
    {
      "name": "Keyword and storage",
      "scope": ["keyword", "keyword.control", "keyword.other", "storage", "storage.type", "storage.modifier", "keyword.operator.new"],
      "settings": { "foreground": "#C6A56A" }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "support.function", "variable.function", "meta.method-call", "entity.name.function.member"],
      "settings": { "foreground": "#89BEB5" }
    },
    {
      "name": "Type",
      "scope": ["entity.name.class", "entity.name.type", "entity.name.type.class", "entity.name.type.namespace", "entity.name.namespace", "support.class", "support.type"],
      "settings": { "foreground": "#DDBA79" }
    },
    {
      "name": "Property",
      "scope": ["variable.object.property", "variable.other.property", "support.variable.property", "meta.object-literal.key"],
      "settings": { "foreground": "#8FA7C7" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#E37C77" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#DDBA79",
    "class": "#DDBA79",
    "type": "#DDBA79",
    "interface": "#89BEB5",
    "struct": "#89BEB5",
    "enum": "#DDBA79",
    "enumMember": "#C6A56A",
    "typeParameter": "#94C47E",
    "parameter": "#C8C0B3",
    "variable": "#D8D5CF",
    "variable.readonly": "#D2B26F",
    "property": "#8FA7C7",
    "property.readonly": "#D2B26F",
    "function": "#89BEB5",
    "method": "#89BEB5",
    "macro": "#94C47E",
    "decorator": "#94C47E",
    "keyword": "#C6A56A",
    "string": "#94C47E",
    "number": "#D2B26F",
    "regexp": "#C69AA5",
    "operator": "#BEB7AD"
  }
